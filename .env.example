# ============================================================
# WCU TRADE — Environment Configuration (example)
# Copy to .env and adjust. NEVER commit real secrets.
# ============================================================

# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WS_URL=http://localhost:4000

# ---- PostgreSQL ----
POSTGRES_USER=wcu
POSTGRES_PASSWORD=wcu_dev_password
POSTGRES_DB=wcu_trade
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wcu:wcu_dev_password@localhost:5432/wcu_trade?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- Market Data ----
# Provider for crypto: binance (public WS, no key needed)
MARKET_DATA_PROVIDER=binance
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com
# Optional providers (leave blank if unused)
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# ---- Simulation / Execution ----
# Stale-quote threshold in ms; market orders rejected if quote older than this
QUOTE_STALE_THRESHOLD_MS=5000
DEFAULT_STARTING_BALANCE=100000
BASE_CURRENCY=USD
DEFAULT_MAKER_FEE_BPS=10
DEFAULT_TAKER_FEE_BPS=10
SLIPPAGE_MODEL=FIXED_BPS
SLIPPAGE_BPS=2
DEFAULT_SPREAD_BPS=4
DEFAULT_MAX_LEVERAGE=10

# ---- Feature Flags ----
ENABLE_MARGIN=true
ENABLE_SHORT_SELLING=true
ENABLE_COMPETITION=true
ENABLE_ASSIGNMENTS=true
ENABLE_STOCKS=true
ENABLE_FOREX=true
ENABLE_CRYPTO=true
ENABLE_FUTURES_SIMULATION=false
ENABLE_BROKER_INTEGRATION=false

# ---- Dev-only fake data (must be explicit) ----
DEMO_DEV_DATA=false
